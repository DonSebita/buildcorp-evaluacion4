# Parámetros para setup_backend.sh (EC2 backend).
# Uso:  cp deploy/backend/parametros.env.example ~/buildcorp-backend.env
#       nano ~/buildcorp-backend.env        (completar)
#       chmod 600 ~/buildcorp-backend.env
#       sudo bash deploy/backend/setup_backend.sh ~/buildcorp-backend.env
# Este archivo con valores reales NO se sube al repositorio.
# Lo que quede vacío lo pregunta el script (las claves sin mostrarlas en pantalla).

# --- RDS PostgreSQL ------------------------------------------------------
# Opción A: por partes (recomendado; el script codifica caracteres raros de la clave)
DB_HOST=            # endpoint de RDS, p. ej. buildcorp-db.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=buildcorp
DB_USER=buildcorp_admin
DB_PASSWORD=
# Opción B: URL completa (si se define, ignora la opción A)
# DATABASE_URL=postgres://usuario:clave@endpoint:5432/buildcorp?sslmode=require
# TLS hacia RDS: require (cifra) o verify-full (cifra y valida el certificado con global-bundle.pem)
DB_SSLMODE=require

# --- S3 ------------------------------------------------------------------
AWS_STORAGE_BUCKET_NAME=    # p. ej. buildcorp-xxxx-assets
AWS_S3_REGION_NAME=us-east-1
USE_S3=True                 # False = archivos locales (útil si S3 aún no está listo)

# --- Frontend y API Gateway ---------------------------------------------
FRONTEND_ORIGIN=            # p. ej. http://54.10.20.30  (IP pública de la EC2 frontend, sin / final)
API_GATEWAY_HOST=           # p. ej. abc123.execute-api.us-east-1.amazonaws.com (sin https://)
ORIGIN_SECRET=              # el mismo valor que se pondrá en API Gateway (X-Origin-Verify). Generar con: openssl rand -hex 24

# --- Opcionales ------------------------------------------------------------
CARGAR_DEMO=1               # 1 = carga datos y usuarios demo (cargar_demo)
AUTODESPLIEGUE=0            # 1 = activa el timer que despliega solo desde origin/main cada 2 min
ZONA_HORARIA=America/Santiago
