# Copia este archivo como .env y completa los valores. El .env real NO se sube
# al repositorio y en la EC2 debe tener permisos 600 (chmod 600 .env).

# --- Django ---
# Obligatoria en producción (settings.prod no arranca sin ella). Generar con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambia-esto
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=
# Muestra las credenciales demo en el login. Dejar en False fuera de pruebas locales.
MOSTRAR_CREDENCIALES_DEMO=False

# --- Base de datos ---
# Local:
DATABASE_URL=postgres://buildcorp:buildcorp@localhost:5432/buildcorp
# RDS con SSL obligatorio (agrega ?sslmode=require al final):
# DATABASE_URL=postgres://buildcorp:<clave>@<endpoint-rds>.rds.amazonaws.com:5432/buildcorp?sslmode=require

# --- CORS (origen del frontend Vite, separados por coma) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Throttling de aplicación (opcional; vacío = desactivado) ---
# Ejemplos: 20/min, 5/second, 1000/day
DRF_THROTTLE_ANON=
DRF_THROTTLE_USER=

# --- Cookies y HTTPS (solo producción; True cuando haya HTTPS) ---
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# --- S3 (archivos subidos y estáticos) ---
# Sin llaves de acceso: la EC2 usa su rol (LabInstanceProfile). No pongas
# AWS_ACCESS_KEY_ID ni AWS_SECRET_ACCESS_KEY aquí.
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
